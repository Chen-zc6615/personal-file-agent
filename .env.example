# Model provider credentials
GEMINI_API_KEY=your-gemini-api-key

# Application settings
ASSISTANT_APP_NAME="Personal Assistant"
ASSISTANT_MODEL_NAME=gemini/gemini-3.6-flash
ASSISTANT_TEMPERATURE=1
ASSISTANT_MAX_TOKENS=2048

# LangGraph persistence
ASSISTANT_SQLITE_PATH=.data/checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true

# MCP servers
ASSISTANT_MCP_SERVERS='{"file_organizer":{"command":"uv","args":["run","python","-m","assistant.mcp_servers.file_organizer"],"transport":"stdio"}}'
